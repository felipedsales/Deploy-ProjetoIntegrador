# =============================================================
# Ferraz Conecta - modelo de variaveis de ambiente
# =============================================================
# Como usar em desenvolvimento:
#   1. copie este arquivo:   cp .env.example .env
#   2. preencha os valores reais no .env
#
# O arquivo .env NUNCA e versionado (ver .gitignore).
# Em producao (Railway), defina estas variaveis no painel do
# servico - nao use arquivo .env em producao.
# =============================================================

# --- Aplicacao ------------------------------------------------
# Ambiente: local | development | testing | production
APP_ENV=local
# true mostra mensagens de erro detalhadas; use false em producao
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Banco de dados (MySQL 8) -------------------------------
# Host do servidor MySQL. (obrigatoria)
DB_HOST=127.0.0.1
# Porta do MySQL. Padrao: 3306. (opcional)
DB_PORT=3306
# Nome do banco. (obrigatoria)
DB_NAME=ferraz_conecta
# Usuario do banco. (obrigatoria)
DB_USER=ferraz_conecta
# Senha do banco. (obrigatoria; pode ficar vazia num MySQL local sem senha,
# mas a linha DB_PASS= precisa existir)
DB_PASS=senha_de_exemplo_troque_no_seu_env
# Caminho do certificado da CA, para exigir TLS na conexao com o banco (RNF03).
# (opcional). Deixe em branco em desenvolvimento: o MySQL local normalmente nao
# tem TLS configurado, e ativar a opcao de SSL do PDO sem um certificado valido
# faz a conexao cair com "MySQL server has gone away". Preencha em producao
# somente se o banco exigir TLS explicito — no Railway, a rede privada entre
# os servicos ja cobre o RNF03 sem precisar desta variavel.
DB_SSL_CA=

# --- Autenticacao social (OAuth) -----------------------------
# Lidas por config/social_auth.php. Deixe em branco para desativar o
# respectivo botao de login social em ambiente local.
# Console Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Portal de apps LinkedIn: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
