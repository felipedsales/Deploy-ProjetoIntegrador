# =============================================================
# Ferraz Conecta - modelo de variaveis de ambiente
# =============================================================
# Como usar em desenvolvimento:
#   1. copie este arquivo:   cp .env.example .env
#   2. preencha os valores reais no .env
#
# O arquivo .env NUNCA e versionado (ver .gitignore).
# Em producao (Railway), defina estas variaveis no painel do
# servico - nao use arquivo .env em producao.
# =============================================================

# --- Aplicacao ------------------------------------------------
# Ambiente: local | development | testing | production
APP_ENV=local
# true mostra mensagens de erro detalhadas; use false em producao
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Banco de dados (MySQL 8) -------------------------------
# Driver PDO. Padrao: mysql. (opcional)
DB_CONNECTION=mysql
# Host do servidor MySQL. (obrigatoria)
DB_HOST=127.0.0.1
# Porta do MySQL. Padrao: 3306. (opcional)
DB_PORT=3306
# Nome do banco. (obrigatoria)
DB_NAME=ferraz_conecta
# Usuario do banco. (obrigatoria)
DB_USER=ferraz_conecta
# Senha do banco. (obrigatoria; pode ficar vazia num MySQL local sem senha,
# mas a linha DB_PASS= precisa existir)
DB_PASS=senha_de_exemplo_troque_no_seu_env

# --- Autenticacao social (OAuth) ---------------------------
# Hoje ainda configurada em config/social_auth.php e NAO lida do ambiente.
# Ao migrar para variaveis de ambiente, documente as chaves aqui, por exemplo:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
